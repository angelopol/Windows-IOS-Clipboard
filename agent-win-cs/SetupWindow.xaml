<Window x:Class="ClipboardAgent.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clipboard — Configuración" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Segoe UI">
    <StackPanel Margin="22">
        <TextBlock Text="Conecta este PC a tu portapapeles compartido."
                   FontSize="13" Margin="0,0,0,14" TextWrapping="Wrap"/>

        <TextBlock Text="URL del servidor" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox x:Name="UrlBox" Padding="6" FontSize="13"
                 Text="https://" ToolTip="Ej. https://tu-app.vercel.app"/>

        <TextBlock Text="Token del dispositivo" FontWeight="SemiBold" Margin="0,14,0,4"/>
        <TextBox x:Name="TokenBox" Padding="6" FontSize="13"
                 ToolTip="Se genera en el panel web /devices"/>

        <TextBlock Text="El token se guarda solo en este equipo (%APPDATA%\ClipboardAgent)."
                   FontSize="11" Foreground="#666" Margin="0,8,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" Click="OnCancel" Width="96" Height="30" Margin="0,0,8,0"/>
            <Button Content="Guardar" Click="OnSave" Width="96" Height="30" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>

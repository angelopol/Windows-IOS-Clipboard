# Neon Postgres — connection string.
# En Vercel: añade la integración Neon (Storage) y luego:  vercel env pull .env.local
# La integración de Neon suele exponer DATABASE_URL (y también POSTGRES_URL).
DATABASE_URL=

# Secreto para firmar la sesión (JWT). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
